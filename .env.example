# ==============================================================================
# Configurações Gerais do Django
# ==============================================================================
SECRET_KEY=django-insecure-mude-esta-chave-em-producao-para-uma-chave-aleatoria-longa
ALLOWED_HOSTS=127.0.0.1,localhost,web,nginx
DJANGO_SETTINGS_MODULE=config.settings.production

# ==============================================================================
# Banco de Dados (PostgreSQL ou SQLite)
# ==============================================================================
# Se DB_NAME for deixado em branco, o Django utilizará automaticamente SQLite!
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# Se quiser usar PostgreSQL, basta descomentar/preencher as linhas abaixo:
# DB_NAME=mcarchive
# DB_USER=mcarchive_user
# DB_PASSWORD=mcarchive_secure_password
# DB_HOST=db
# DB_PORT=5432

# ==============================================================================
# HTTPS / SSL (Mantenha False localmente e True em produção com certificado)
# ==============================================================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Domínios confiáveis para submissão de formulários (CSRF) via HTTPS/Proxy
CSRF_TRUSTED_ORIGINS=https://mcarchive.tsnunes.com.br,http://localhost

# ==============================================================================
# Configurações de E-mail (Opcional / Produção)
# ==============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app
