# ==============================================================================
# Configurações Gerais do Django
# ==============================================================================
# Chave secreta de produção (gere uma chave forte e única para cada ambiente)
SECRET_KEY=django-insecure-mude-esta-chave-em-producao-para-uma-chave-aleatoria-longa

# Hosts permitidos separados por vírgula (ex: 127.0.0.1,localhost,meudominio.com)
ALLOWED_HOSTS=127.0.0.1,localhost,web

# Módulo de configurações (development ou production)
DJANGO_SETTINGS_MODULE=config.settings.production

# ==============================================================================
# Banco de Dados (PostgreSQL)
# ==============================================================================
DB_NAME=mcarchive
DB_USER=mcarchive_user
DB_PASSWORD=mcarchive_secure_password
# No Docker Compose, utilize o nome do serviço 'db'; localmente utilize 'localhost'
DB_HOST=db
DB_PORT=5432

# ==============================================================================
# Configurações de E-mail (Opcional / Produção)
# ==============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app

